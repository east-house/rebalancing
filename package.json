{
  "name": "portfolio-rebalancer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "dev:vite": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "catalog:update": "uv run --with finance-datareader python scripts/build_instrument_catalog.py",
    "research:update": "uv run --with finance-datareader --with beautifulsoup4 python scripts/build_etf_research_data.py",
    "report:generate": "uv run --with-requirements requirements-market-report.txt python -m market_report_pipeline.us_market_report run --output action-output/market-report",
    "report:publish-local": "uv run --with-requirements requirements-market-report.txt python -m market_report_pipeline.publish_market_report_web --source action-output/market-report --project-root .",
    "report:publish-r2": "uv run --with-requirements requirements-market-report.txt python -m market_report_pipeline.publish_market_report_web --source action-output/market-report --project-root . --upload-r2",
    "report:update": "npm run report:generate && npm run report:publish-local",
    "report:test": "uv run --with-requirements requirements-market-report.txt python -m pytest tests/market_report_pipeline -q",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.0.5",
    "wrangler": "^4.112.0"
  }
}
