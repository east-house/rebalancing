{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rebalancing",
  "compatibility_date": "2026-07-19",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "r2_buckets": [
    {
      "binding": "MARKET_DATA",
      "bucket_name": "closeprice"
    }
  ]
}
